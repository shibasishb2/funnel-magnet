# Copy this file to .streamlit/secrets.toml, which Git ignores, and add your key there.
# Never put a real key in this example file.

# AI analysis stays off, even with a key, until this is "true".
FM_AI_ENABLED = "true"
GEMINI_API_KEY = "paste-your-key-here"

# Optional. These are the defaults.
# GEMINI_MODEL = "gemini-3.1-flash-lite"
# GEMINI_TIER = "free"

# For an app shared with users in the EEA, Switzerland or the UK:
# GEMINI_TIER = "paid"
# FM_SHARED_DEPLOYMENT = "true"
